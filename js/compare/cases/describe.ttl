@prefix ex: <https://example.org/sparql-examples/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sib: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# One of the cases that compare.js checks, see ../README.md.
ex:describe a sh:SPARQLExecutable, sib:SPARQLDescribeExecutable ;
    rdfs:comment "describe"@en ;
    sib:describe """PREFIX ex: <http://example.org/>
DESCRIBE ?s ex:thing WHERE { ?s ex:p ?o }""" .
