@prefix ex: <https://example.org/sparql-examples/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sib: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# One of the cases that compare.js checks, see ../README.md.
ex:paths a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "paths"@en ;
    sh:select """PREFIX ex: <http://example.org/>
SELECT * WHERE {
  ?a ex:p* ?b .
  ?b ex:q+ ?c .
  ?c ex:r? ?d .
  ?d ^ex:s* ?e .
  ?e ex:t/ex:u ?f .
  ?f (ex:v|ex:w) ?g .
  ?g ^ex:x ?h .
}""" .
