@prefix ex: <https://example.org/sparql-examples/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sib: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# One of the cases that compare.js checks, see ../README.md.
ex:unused-variable a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "unused-variable"@en ;
    sh:select """PREFIX ex: <http://example.org/>
SELECT ?s ?unbound WHERE { ?s ex:p ex:o }""" .
