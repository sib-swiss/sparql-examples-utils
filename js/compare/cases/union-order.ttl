@prefix ex: <https://example.org/sparql-examples/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sib: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# One of the cases that compare.js checks, see ../README.md.
ex:union-order a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "union-order"@en ;
    sh:select """PREFIX ex: <http://example.org/>
SELECT * WHERE {
  { ?s ex:first ?o } UNION { ?s ex:second ?o } UNION { ?s ex:third ?o }
}""" .
