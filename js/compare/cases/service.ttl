@prefix ex: <https://example.org/sparql-examples/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sib: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# One of the cases that compare.js checks, see ../README.md.
ex:service a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "service"@en ;
    sh:select """PREFIX ex: <http://example.org/>
SELECT * WHERE {
  SERVICE <https://example.org/sparql> { ?s ex:a ?o }
  SERVICE ?endpoint { ?o ex:b ?x }
  SERVICE <https://example.org/sparql> { ?x ex:c ?y }
}""" .
