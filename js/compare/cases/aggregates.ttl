@prefix ex: <https://example.org/sparql-examples/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sib: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# One of the cases that compare.js checks, see ../README.md.
ex:aggregates a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    rdfs:comment "aggregates"@en ;
    sh:select """PREFIX ex: <http://example.org/>
SELECT ?s (COUNT(DISTINCT ?o) AS ?n) (CONCAT(STR(SAMPLE(?o)), "...") AS ?sample) (GROUP_CONCAT(?o; SEPARATOR=",") AS ?all)
WHERE { ?s ex:a ?o }
GROUP BY ?s
HAVING (COUNT(?o) >= 5 && MAX(?o) < 10)
ORDER BY DESC(COUNT(*)) ?s""" .
