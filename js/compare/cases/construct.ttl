@prefix ex: <https://example.org/sparql-examples/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sib: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# One of the cases that compare.js checks, see ../README.md.
ex:construct a sh:SPARQLExecutable, sh:SPARQLConstructExecutable ;
    rdfs:comment "construct"@en ;
    sh:construct """PREFIX ex: <http://example.org/>
CONSTRUCT { ?s ex:copy ?o . ?o ex:back ?s . ?s a ex:Thing } WHERE { ?s ex:p ?o }""" .
